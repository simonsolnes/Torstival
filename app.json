{
  "expo": {
    "name": "Torstival",
    "slug": "torstival",
    "version": "1.4.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "no.solnes.torstival",
      "buildNumber": "5",
      "infoPlist": {
        "NSCameraUsageDescription": "Torstival trenger kameratilgang for å blinke med lommelykten. Ingen bilder eller video tas opp.",
        "CFBundleDevelopmentRegion": "nb",
        "CFBundleLocalizations": ["nb"]
      },
      "supportsTablet": true
    },
    "android": {
      "package": "no.solnes.torstival",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#c4b5fd"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "./plugins/with-local-signing.cjs",
      ["expo-build-properties", { "ios": { "enableSceneSupport": true } }]
    ]
  }
}

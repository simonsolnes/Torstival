{
  "expo": {
    "name": "Torstival",
    "slug": "torstival",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "no.solnes.torstival",
      "supportsTablet": true
    },
    "android": {
      "package": "no.solnes.torstival",
      "versionCode": 1,
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": ["./plugins/with-local-signing.cjs"]
  }
}
